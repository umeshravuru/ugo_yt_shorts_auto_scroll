{
  "manifest_version": 3,
  "name": "Shorts Auto-Scroll",
  "version": "1.1.0",
  "description": "Automatically advances to the next YouTube Short when the current one finishes playing. Click the toolbar icon to toggle on/off (off by default).",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shorts Auto-Scroll (click to toggle)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
